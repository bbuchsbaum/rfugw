# Conservative, portable defaults. Do not put -O2 or -fopenmp here;
# R supplies optimization flags and $(SHLIB_OPENMP_CXXFLAGS).
#
# Opt-in fast flags (can change IEEE numerics; not for CRAN/sanitizer):
#   RFUGW_FAST_FLAGS="-march=native -ffast-math -fno-math-errno -fno-trapping-math"
# Sanitizer / -Werror:
#   RFUGW_EXTRA_CXXFLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer"
#   RFUGW_EXTRA_LIBS="-fsanitize=address,undefined"
# Homebrew libomp when R's SHLIB_OPENMP flags are not enough:
#   RFUGW_OPENMP_FLAGS="-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include"
#   RFUGW_OPENMP_LIBS="-L/opt/homebrew/opt/libomp/lib -lomp"
# See inst/build-profiles.md.

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) $(RFUGW_OPENMP_FLAGS) $(RFUGW_FAST_FLAGS) $(RFUGW_EXTRA_CXXFLAGS)
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS) $(RFUGW_OPENMP_LIBS) $(RFUGW_EXTRA_LIBS)
