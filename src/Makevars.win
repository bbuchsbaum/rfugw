# Conservative Windows defaults. R supplies optimization and OpenMP flags.
# Opt in to aggressive flags with RFUGW_FAST_FLAGS. See inst/build-profiles.md.

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) $(RFUGW_OPENMP_FLAGS) $(RFUGW_FAST_FLAGS) $(RFUGW_EXTRA_CXXFLAGS)
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS) $(RFUGW_OPENMP_LIBS) $(RFUGW_EXTRA_LIBS)
